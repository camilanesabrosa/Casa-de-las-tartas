[Unit]
Description=Casa de las Tartas - catalogo y administracion
After=network.target

[Service]
Type=simple
User=casadelastartas
Group=casadelastartas
WorkingDirectory=/srv/casadelastartas/current
ExecStart=/opt/node24/bin/node /srv/casadelastartas/current/server.js
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=4312
Environment=MOSTRADOR_DATABASE_PATH=/var/lib/casadelastartas/business.sqlite
Environment=VINEXT_TRUST_PROXY=1
Environment=VINEXT_TRUSTED_HOSTS=sinnick.dev,www.sinnick.dev
StateDirectory=casadelastartas
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/casadelastartas
MemoryMax=512M

[Install]
WantedBy=multi-user.target
